<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WeGo - Travel Itinerary Generator</title>
    <link rel="stylesheet" href="/css/itinerary.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>
<body>
    <header class="header">
        <nav class="navbar">
            <div class="logo">
                <img src="/img/logo-full.png" alt="logo">
            </div>
            <ul class="nav-list">
                <li><a href="/#home">Home</a></li>
                <li><a href="/#destination">Discover</a></li>
                <li><a href="/#cta">Services</a></li>
                <li><a href="/#why-us">Why WeGo</a></li>
                <li><a href="/#footer">Contact</a></li>
            </ul>
            <% if (user) { %>
                <a onclick="window.location.href=`/profile/<%= user._id %>`" class="avatar"><img class="avatar-img" src="<%= user.profileImage %>" alt="avatar"></a>
                <% } else { %>
                  <a onclick="window.location.href = `/auth`" class="btn">Sign up</a>
              <% } %>
        </nav>
    </header>

    <main class="main-content">
        <section class="itinerary-generator" id="itinerary">
            <div class="container">
                <h1 class="section-title">Plan Your Perfect Trip</h1>
                <div class="plan-form">
                    <form id="itinerary-form">
                        <div class="form-group">
                            <label for="destination">Destination</label>
                            <input type="text" id="destination" placeholder="Enter destination" required>
                        </div>
                        <div class="form-group-tiles">
                            <div class="form-group">
                                <label for="days">Number of Days</label>
                                <input type="number" id="days" min="1" max="30" placeholder="Enter number of days">
                            </div>
                            <div class="form-group">
                                <label for="days">Number of Hours</label>
                                <input type="number" id="hours" min="1" max="24" placeholder="Enter number of hours">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="interests">Interests</label>
                            <select id="interestSelect">
                                <option value="" disabled selected>Select Interests</option>
                                <option value="Culture">Culture</option>
                                <option value="History">History</option>
                                <option value="Nature">Nature</option>
                                <option value="Food">Food</option>
                                <option value="Adventure">Adventure</option>
                                <option value="Relaxation">Relaxation</option>
                            </select>
                        </div>
                        <div class="interests-container" id="interestContainer">
                            <!-- Selected interest chips will be dynamically inserted here -->
                        </div>
                        
                        <button id="generateItineraryBtn" type="submit" class="btn">Generate Itinerary</button>
                    </form>
                </div>
            </div>
            
            <!-- Itinerary output section -->
            <div id="itinerary-output" class="itinerary-output" style="display: none;">
                <div id="itinerary-results" class="itinerary-results">
                    <h2>Day-by-Day Itinerary</h2>
                    <div id="itinerary-details">
                        <!-- <div class="day-section">
                            <h3>Day 1</h3>
                            <div class="activity">
                              <span class="activity-time">09:00 AM</span>
                              <span class="activity-description">Visit a museum</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">10:00 AM</span>
                              <span class="activity-description">Try street food</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">12:00 PM</span>
                              <span class="activity-description">Explore the temple</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">02:00 PM</span>
                              <span class="activity-description">Went to the zoo Went to the zoo Went to the zoo Went to the zoo Went to the zoo</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                        </div>
                        <div class="day-section">
