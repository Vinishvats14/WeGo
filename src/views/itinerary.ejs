                              <span class="activity-time">09:00 AM</span>
                              <span class="activity-description">Visit a museum</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">10:00 AM</span>
                              <span class="activity-description">Try street food</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">12:00 PM</span>
                              <span class="activity-description">Explore the temple</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                            <div class="activity">
                              <span class="activity-time">02:00 PM</span>
                              <span class="activity-description">Went to the zoo</span>
                              <button class="remove-btn">Remove</button>
                            </div>
                        </div> -->
                    </div>
                </div>
            </div>
        </section>
    
        <!-- Sidebar with map and hotels -->
        <aside class="sidebar" id="sidebar" style="display: none;">
            <div class="map-container">
                <h3>Map</h3>
                <div id="map"></div>
             </div>
            <div class="redirects">
                <h3>What Next ?</h3>
                
                <button id="viewDestination" onclick="window.location.href = '/destination?place=delhi'" class="btn">View Destination</button>
                <button onclick="window.location.href = '/hotels'" class="btn">Find Hotels</button>
                <button onclick="window.location.href = '/flights'" class="btn">Finder Flights</button>
            </div>
        </aside>
    </main>
    

    <footer class="footer" id="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <img src="/img/logo-full.png" alt="logo" class="footer-logo">
                    <p class="footer-description">Your goto companion and travel gateway to extraordinary adventures around the world.</p>
                </div>
                <div class="footer-links">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="#home">Home</a></li>
                        <li><a href="#discover">Discover</a></li>
                        <li><a href="#about">About Us</a></li>
                    </ul>
                </div>
                <div class="footer-contact">
                    <h3>Contact Us</h3>
                    <p><i class="fas fa-map-marker-alt"></i> 3146 Delhi, India</p>
                    <p><i class="fas fa-phone"></i> +1 (555) 123-4567</p>
                    <p><i class="fas fa-envelope"></i> info@travelboom.com</p>
                </div>
                <div class="footer-newsletter">
                    <h3>Newsletter</h3>
                    <p>Subscribe for travel updates and exclusive offers</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Your email" required>
                        <button type="submit" class="btn">Subscribe</button>
                    </form>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 WeGo. All rights reserved.</p>
                <div class="social-links">
                    <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>
    </footer>
    <!-- Chatbot Scripts  -->
    <script src="https://cdn.botpress.cloud/webchat/v2.1/inject.js"></script>
    <script src="https://mediafiles.botpress.cloud/<your-bot-api-key>/webchat/v2.1/config.js"></script>

    <!-- JQuery and Custom JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="/js/itinerary.js"></script>
</body>
</html>
