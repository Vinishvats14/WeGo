    <script>
        // Get URL parameters for place and hotel type
        const urlParams = new URLSearchParams(window.location.search);
        const place = urlParams.get('place') || 'Popular Destinations';
        const hotelType = urlParams.get('type') || 'All Types';

        // Update the page title and heading
        document.getElementById('place').textContent = place;
        document.getElementById('hotel-type').textContent = hotelType.charAt(0).toUpperCase() + hotelType.slice(1);
        document.title = `Hotels in ${place} - ${hotelType.charAt(0).toUpperCase() + hotelType.slice(1)} | TravelBuddy`;

        // Pre-fill the search form with the current parameters
        document.getElementById('destination-input').value = place;
        if (['affordable', 'moderate', 'premium'].includes(hotelType.toLowerCase())) {
            document.getElementById('hotel-type-select').value = hotelType.toLowerCase();
        }

        // Handle the search form submission
        document.getElementById('hotel-search-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const destination = document.getElementById('destination-input').value;
            const type = document.getElementById('hotel-type-select').value;
            
            if (destination && type) {
                window.location.href = `hotels.html?place=${encodeURIComponent(destination)}&type=${encodeURIComponent(type)}`;
            }
        });

        // Handle the filter chips
        const filterChips = document.querySelectorAll('.filter-chip');
        filterChips.forEach(chip => {
            chip.addEventListener('click', function() {
                this.classList.toggle('active');
                filterHotels();
            });
        });

        // Handle tabs switching
        const enquiryTabs = document.querySelectorAll('.enquiry-tab');
        const enquiryForms = document.querySelectorAll('.enquiry-form');

        enquiryTabs.forEach(tab => {
            tab.addEventListener('click', function() {
                // Remove active class from all tabs and forms
                enquiryTabs.forEach(t => t.classList.remove('active'));
                enquiryForms.forEach(f => f.classList.remove('active'));
                
                // Add active class to current tab
                this.classList.add('active');
                
                // Show the corresponding form
                const tabType = this.getAttribute('data-tab');
                document.querySelector(`.${tabType}-form`).classList.add('active');
            });
        });

