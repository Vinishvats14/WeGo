            // Filter hotels by type (in a real app, the API would do this)
            window.allHotels = hotels; // Store all hotels in a global variable for filtering
            let filteredHotels = filterHotelsByType(hotels, hotelType);
            displayHotels(filteredHotels);
        }, 1000); // Simulate 1 second loading time

        // Function to filter hotels by type
        function filterHotelsByType(hotels, type) {
            if (type.toLowerCase() === 'all types') return hotels;
            
            return hotels.filter(hotel => {
                const price = parseInt(hotel.priceRange.split(' - ')[0].replace(/[^\d]/g, ''));
                if (type.toLowerCase() === 'affordable') {
                    return price < 10000;
                } else if (type.toLowerCase() === 'moderate') {
                    return price >= 10000 && price < 15000;
                } else if (type.toLowerCase() === 'premium') {
                    return price >= 15000;
                }
                return true;
            });
        }

        // Function to display hotels
        function displayHotels(hotels) {
            const hotelsContainer = document.getElementById('hotels-container');
            
            if (!hotels || hotels.length === 0) {
                hotelsContainer.innerHTML = '<div class="error-message">No hotels found. Please try a different search.</div>';
                return;
            }
            
            const hotelsGrid = document.createElement('div');
            hotelsGrid.className = 'hotels-grid';
            
            hotels.forEach(hotel => {
                const hotelCard = document.createElement('div');
                hotelCard.className = 'hotel-card';
                hotelCard.setAttribute('data-amenities', hotel.amenities.join(','));
                
                hotelCard.innerHTML = `
                    <img src="${hotel.image}" alt="${hotel.name}" class="hotel-image">
                    <div class="hotel-details">
                        <h3 class="hotel-name">${hotel.name}</h3>
                        <div class="hotel-rating">
                            ${getStarRating(hotel.rating)}
                            <span>(${hotel.rating})</span>
                        </div>
                        <div class="hotel-location">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            ${hotel.location}
                        </div>
                        <p class="hotel-description">${hotel.description}</p>
                        <div class="hotel-price">${hotel.priceRange} per night</div>
                        <a href="${hotel.bookingLink}" class="btn" target="_blank">Book Now</a>
                    </div>
                `;
                
                hotelsGrid.appendChild(hotelCard);
            });
            
            hotelsContainer.innerHTML = '';
            hotelsContainer.appendChild(hotelsGrid);
        }
        
        // Generate star rating HTML
        function getStarRating(rating) {
            const fullStars = Math.floor(rating);
            const halfStar = rating % 1 >= 0.5;
            const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
            
            let starsHTML = '';
            
            // Full stars
            for (let i = 0; i < fullStars; i++) {
                starsHTML += '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#ffa41b" stroke="#ffa41b" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>';
            }
            
            // Half star
            if (halfStar) {
                starsHTML += '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#ffa41b" stroke="#ffa41b" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill-opacity="0.5"></polygon><path d="M12 2 L12 17.77" stroke="#ffa41b" stroke-width="1"></path><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77" fill="#ffa41b"></polygon></svg>';
            }
            
            // Empty stars
            for (let i = 0; i < emptyStars; i++) {
                starsHTML += '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffa41b" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>';
            }
            
            return starsHTML;
        }
        
        // Filter hotels based on selected amenities
        function filterHotels() {
            const activeFilters = Array.from(document.querySelectorAll('.filter-chip.active'))
                .map(chip => chip.getAttribute('data-filter').replace('amenity-', ''));
            
            if (activeFilters.length === 0) {
                // If no filters are selected, show all hotels of the current type
                const filteredHotels = filterHotelsByType(window.allHotels, hotelType);
                displayHotels(filteredHotels);
                return;
            }
            
            // Filter hotels by type first
            const typeFiltered = filterHotelsByType(window.allHotels, hotelType);
            
            // Then filter by amenities
            const amenityFiltered = typeFiltered.filter(hotel => {
                return activeFilters.every(filter => hotel.amenities.includes(filter));
            });
            
            displayHotels(amenityFiltered);
        }
    </script>
