                    rating: 4.8,
                    priceRange: "₹15,000 - ₹20,000",
                    bookingLink: "https://booking.com/grand-sunrise",
                    description: "Luxury resort with stunning views, infinity pool, and spa services. Enjoy complimentary breakfast and evening cocktails.",
                    location: place,
                    amenities: ["pool", "wifi", "breakfast", "spa"]
                },
                {
                    name: "Cozy Nest Hotel",
                    image: "https://imgs.search.brave.com/U6FyIJp4fzliM1I5-Ti4WVSA-edbixcwqTsMA79vlDc/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9pbWFn/ZXMuc3F1YXJlc3Bh/Y2UtY2RuLmNvbS9j/b250ZW50L3YxLzU2/ZGZkNWNjOWY3MjY2/ZWQ3ZjA0YjY0ZC8x/NTg1NzQzNzQ2Mjky/LUdRWFdDTUoxWFQ1/SkxWWUo1VUNVL2lt/YWdlLWFzc2V0Lmpw/ZWc",
                    rating: 4.5,
                    priceRange: "₹8,000 - ₹12,000",
                    bookingLink: "https://booking.com/cozy-nest",
                    description: "Comfortable and affordable stay with modern amenities. Perfect for families and business travelers alike.",
