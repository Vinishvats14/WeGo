                </div>
            </div>
        </div>
    </section>

    <!-- Top Section - Display Place and Hotel Type -->
    <section class="top-section">
        <h1 id="place-type-title">Hotels in <span id="place">...</span> – <span id="hotel-type">...</span></h1>
        <p>We've found the best stays that match your preferences. Click on a hotel to book now.</p>
    </section>

    <!-- Main Content - Hotels Grid -->
    <main class="main-content">
        <div id="hotels-container">
            <div class="loading">Loading hotels...</div>
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
